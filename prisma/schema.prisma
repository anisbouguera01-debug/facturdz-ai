// FacturDZ AI — schéma Prisma initial (PROPOSITION, à valider avant la Phase 2)
// Prisma 7.x (stable). L'URL de connexion est dans prisma.config.ts (plus dans ce fichier).
//
// Principes :
// - Toute table métier porte organizationId (multi-tenant, base partagée).
// - Les relations entre objets d'une même organisation utilisent des clés étrangères
//   COMPOSITES (id + organizationId) : la base elle-même refuse une facture liée au
//   client d'une autre organisation.
// - Montants : Decimal(14,2). Taux : Decimal(5,2). Coûts IA : Decimal(14,6).
// - Aucun taux de TVA / règle fiscale codé en dur : table TaxRate par organisation.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum MemberRole {
  OWNER
  ADMIN
  ACCOUNTANT
  EMPLOYEE
  VIEWER
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

// OVERDUE n'est PAS stocké : il est dérivé (dueDate < aujourd'hui ET reste à payer > 0).
// UNPAID = ISSUED sans paiement. Évite un statut périmé et un cron obligatoire.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  CARD
  OTHER
}

enum DocumentType {
  INVOICE
  QUOTE
}

enum AIProviderName {
  OPENAI
  GEMINI
}

enum AIFeature {
  INVOICE_GENERATION
  QUOTE_GENERATION
  ANALYTICS
  CUSTOMER_MESSAGE
  GENERAL_ASSISTANT
}

enum AIUsageStatus {
  SUCCESS
  ERROR
  REJECTED_LIMIT
  INVALID_OUTPUT
}

enum AIDraftStatus {
  PENDING
  CONFIRMED
  DISCARDED
  EXPIRED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum LimitKey {
  INVOICES_PER_MONTH
  QUOTES_PER_MONTH
  MEMBERS
  STORAGE_MB
  AI_REQUESTS_PER_MONTH
  AI_TOKENS_PER_MONTH
  AI_BUDGET_USD_PER_MONTH
}

// ─────────────────── Authentification (Better Auth) ───────────────────
// Better Auth gère User/Session/Account/Verification. `name` et `image` sont
// exigés par Better Auth ; `image` sert d'avatar.

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified Boolean      @default(false)
  name          String
  firstName     String?
  lastName      String?
  phone         String?
  image         String?
  status        UserStatus   @default(ACTIVE)
  platformRole  PlatformRole @default(USER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships OrganizationMember[]
  aiUsages    AIUsage[]
  auditLogs   AuditLog[]

  @@map("users")
}

model Session {
  id                   String   @id @default(cuid())
  userId               String
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Contient le hash du mot de passe (provider "credential") ou le compte Google.
model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ───────────────────────────── Tenant ─────────────────────────────

model Organization {
  id                String  @id @default(cuid())
  name              String
  slug              String  @unique
  legalName         String?
  logoUrl           String?
  address           String?
  wilaya            String?
  commune           String?
  phone             String?
  email             String?
  website           String?
  nif               String?
  nis               String?
  rc                String?
  articleImposition String? // AI — à confirmer avec un comptable
  rib               String?
  defaultCurrency   String  @default("DZD")

  invoiceSettings Json @default("{}") // préfixes, mentions, conditions par défaut, template PDF
  aiSettings      Json @default("{}") // fournisseur/modèle préférés, features activées

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      OrganizationMember[]
  customers    Customer[]
  products     Product[]
  taxRates     TaxRate[]
  quotes       Quote[]
  invoices     Invoice[]
  payments     Payment[]
  sequences    DocumentSequence[]
  subscription Subscription?
  aiUsages     AIUsage[]
  aiDrafts     AIDraft[]
  auditLogs    AuditLog[]

  @@map("organizations")
}

model OrganizationMember {
  id             String     @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

// ───────────────────────────── Référentiels ─────────────────────────────

model TaxRate {
  id             String   @id @default(cuid())
  organizationId String
  label          String
  rate           Decimal  @db.Decimal(5, 2)
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("tax_rates")
}

model Customer {
  id                String       @id @default(cuid())
  organizationId    String
  type              CustomerType @default(COMPANY)
  name              String
  companyName       String?
  email             String?
  phone             String?
  address           String?
  wilaya            String?
  commune           String?
  nif               String?
  nis               String?
  rc                String?
  articleImposition String?
  notes             String?
  archivedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotes       Quote[]
  invoices     Invoice[]

  @@unique([id, organizationId])
  @@index([organizationId, name])
  @@index([organizationId, createdAt])
  @@map("customers")
}

model Product {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  sku            String?
  description    String?
  type           ProductType @default(PRODUCT)
  unit           String?
  priceHT        Decimal     @db.Decimal(14, 2)
  vatRate        Decimal     @db.Decimal(5, 2)
  currency       String      @default("DZD")
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteItems   QuoteItem[]
  invoiceItems InvoiceItem[]

  @@unique([id, organizationId])
  @@unique([organizationId, sku])
  @@index([organizationId, name])
  @@map("products")
}

// ───────────────────────────── Numérotation ─────────────────────────────
// Un compteur par (organisation, type, année). Incrément par
// UPDATE ... SET next = next + 1 RETURNING dans la transaction d'émission :
// le verrou de ligne PostgreSQL sérialise les émissions concurrentes.

model DocumentSequence {
  id             String       @id @default(cuid())
  organizationId String
  documentType   DocumentType
  year           Int
  prefix         String
  padding        Int          @default(6)
  nextValue      Int          @default(1)
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, documentType, year])
  @@map("document_sequences")
}

// ───────────────────────────── Devis ─────────────────────────────

model Quote {
  id             String      @id @default(cuid())
  organizationId String
  number         String? // attribué à l'envoi
  customerId     String
  status         QuoteStatus @default(DRAFT)
  issueDate      DateTime    @db.Date
  expiryDate     DateTime?   @db.Date
  currency       String      @default("DZD")
  notes          String?
  terms          String?
  subtotal       Decimal     @default(0) @db.Decimal(14, 2)
  discountTotal  Decimal     @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal     @default(0) @db.Decimal(14, 2)
  total          Decimal     @default(0) @db.Decimal(14, 2)
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: NoAction)
  items        QuoteItem[]
  invoice      Invoice?

  @@unique([id, organizationId])
  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, createdAt])
  @@map("quotes")
}

model QuoteItem {
  id             String  @id @default(cuid())
  organizationId String
  quoteId        String
  productId      String?
  position       Int
  description    String
  quantity       Decimal @db.Decimal(14, 3)
  unitPrice      Decimal @db.Decimal(14, 2)
  discountRate   Decimal @default(0) @db.Decimal(5, 2)
  vatRate        Decimal @db.Decimal(5, 2)
  subtotal       Decimal @db.Decimal(14, 2)
  taxAmount      Decimal @db.Decimal(14, 2)
  total          Decimal @db.Decimal(14, 2)

  quote   Quote    @relation(fields: [quoteId, organizationId], references: [id, organizationId], onDelete: Cascade)
  product Product? @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: NoAction)

  @@unique([quoteId, position])
  @@index([quoteId])
  @@map("quote_items")
}

// ───────────────────────────── Factures ─────────────────────────────

model Invoice {
  id               String        @id @default(cuid())
  organizationId   String
  // Attribué uniquement à l'émission (DRAFT → ISSUED) : pas de trou dans la séquence.
  invoiceNumber    String?
  customerId       String
  quoteId          String?
  status           InvoiceStatus @default(DRAFT)
  issueDate        DateTime      @db.Date
  dueDate          DateTime?     @db.Date
  currency         String        @default("DZD")
  notes            String?
  paymentTerms     String?
  subtotal         Decimal       @default(0) @db.Decimal(14, 2)
  discountTotal    Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal         Decimal       @default(0) @db.Decimal(14, 2)
  total            Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid       Decimal       @default(0) @db.Decimal(14, 2)
  // Copie figée des infos émetteur/client au moment de l'émission (le PDF reste exact
  // même si le client est modifié ensuite).
  sellerSnapshot   Json?
  customerSnapshot Json?
  issuedAt         DateTime?
  cancelledAt      DateTime?
  createdById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: NoAction)
  quote        Quote?        @relation(fields: [quoteId, organizationId], references: [id, organizationId], onDelete: NoAction)
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([id, organizationId])
  @@unique([organizationId, invoiceNumber])
  @@unique([quoteId, organizationId]) // un devis → au plus une facture
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, dueDate])
  @@index([organizationId, issueDate])
  @@index([organizationId, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id             String  @id @default(cuid())
  organizationId String
  invoiceId      String
  productId      String?
  position       Int
  description    String
  quantity       Decimal @db.Decimal(14, 3)
  unitPrice      Decimal @db.Decimal(14, 2)
  discountRate   Decimal @default(0) @db.Decimal(5, 2)
  vatRate        Decimal @db.Decimal(5, 2)
  subtotal       Decimal @db.Decimal(14, 2)
  taxAmount      Decimal @db.Decimal(14, 2)
  total          Decimal @db.Decimal(14, 2)

  invoice Invoice  @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  product Product? @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: NoAction)

  @@unique([invoiceId, position])
  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  invoiceId      String
  amount         Decimal       @db.Decimal(14, 2)
  paymentDate    DateTime      @db.Date
  method         PaymentMethod
  reference      String?
  notes          String?
  createdById    String?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: NoAction)

  @@index([organizationId, paymentDate])
  @@index([invoiceId])
  @@map("payments")
}

// ───────────────────────────── Abonnements ─────────────────────────────

model SubscriptionPlan {
  id           String   @id @default(cuid())
  code         String   @unique // FREE, BASIC, PRO, BUSINESS
  name         String
  priceMonthly Decimal  @default(0) @db.Decimal(14, 2)
  currency     String   @default("DZD")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  limits        UsageLimit[]
  subscriptions Subscription[]

  @@map("subscription_plans")
}

// Une ligne par limite : ajouter une limite = ajouter une valeur d'enum, pas une colonne.
// value = null → illimité.
model UsageLimit {
  id     String   @id @default(cuid())
  planId String
  key    LimitKey
  value  Decimal? @db.Decimal(14, 2)

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@map("usage_limits")
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String             @unique
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

// ───────────────────────────── IA ─────────────────────────────

// Prix par modèle, versionnés dans le temps (jamais dans le code métier).
model ModelPricing {
  id                              String         @id @default(cuid())
  provider                        AIProviderName
  model                           String
  inputCostPerMillionTokens       Decimal        @db.Decimal(12, 6)
  outputCostPerMillionTokens      Decimal        @db.Decimal(12, 6)
  cachedInputCostPerMillionTokens Decimal?       @db.Decimal(12, 6)
  currency                        String         @default("USD")
  effectiveFrom                   DateTime
  effectiveTo                     DateTime?
  createdAt                       DateTime       @default(now())

  usages AIUsage[]

  @@index([provider, model, effectiveFrom])
  @@map("model_pricing")
}

model AIUsage {
  id                String         @id @default(cuid())
  organizationId    String
  userId            String?
  provider          AIProviderName
  model             String
  feature           AIFeature
  requestId         String         @unique
  providerRequestId String?
  inputTokens       Int            @default(0)
  cachedInputTokens Int            @default(0)
  outputTokens      Int            @default(0)
  totalTokens       Int            @default(0)
  estimatedCost     Decimal?       @db.Decimal(14, 6) // null si aucun tarif connu
  currency          String         @default("USD")
  pricingId         String?
  latencyMs         Int
  status            AIUsageStatus
  errorCode         String?
  createdAt         DateTime       @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  pricing      ModelPricing? @relation(fields: [pricingId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, feature, createdAt])
  @@index([provider, model, createdAt])
  @@map("ai_usage")
}

// Proposition de l'IA en attente de confirmation. Jamais transformée en facture
// sans action explicite de l'utilisateur.
model AIDraft {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  feature        AIFeature
  payload        Json // JSON validé par Zod
  status         AIDraftStatus @default(PENDING)
  resultEntityId String?
  expiresAt      DateTime
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, status])
  @@map("ai_drafts")
}

// ───────────────────────────── Audit & sécurité ─────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String // ex. invoice.issued, payment.created, settings.updated
  entity         String?
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// Rate limiting en base (fenêtre fixe) : fonctionne en serverless sans Redis.
// Remplaçable par Upstash Redis si le trafic l'exige.
model RateLimitBucket {
  key       String   @id // ex. "ai:org:<id>:2026-10-01T12:30"
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// Compteurs anti brute-force de Better Auth (connexion, inscription…).
// Structure imposée par Better Auth (rateLimit.storage = "database").
model AuthRateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("auth_rate_limits")
}
