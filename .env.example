# ─────────────────────────────────────────────────────────────
# FacturDZ AI — variables d'environnement
# Copier en `.env.local` (développement). NE JAMAIS committer de vraies valeurs.
# Chaque environnement (development / staging / production) a ses propres valeurs,
# définies dans l'hébergeur (ex. Vercel → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# development | staging | production
APP_ENV=development
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://facturdz:facturdz@localhost:5432/facturdz
# Base dédiée aux tests d'intégration (détruite et recréée par les tests)
TEST_DATABASE_URL=postgresql://facturdz:facturdz@localhost:5432/facturdz_test
# Base « fantôme » pour `prisma migrate dev` (optionnelle en local, fournie par la CI)
# SHADOW_DATABASE_URL=postgresql://facturdz:facturdz@localhost:5432/facturdz_shadow

# Uniquement dans l'environnement de développement cloud de Claude, où le moteur de
# migration Prisma ne peut pas être téléchargé (permet `prisma generate`/`validate`).
# Ne PAS définir sur une machine normale, en CI ni en production.
# PRISMA_SCHEMA_ENGINE_BINARY=/bin/false

# Authentification — générer avec : openssl rand -base64 32
AUTH_SECRET=

# IA — les clés restent côté serveur, jamais préfixées NEXT_PUBLIC_
AI_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=

# URL publique de l'application (seule variable exposée au navigateur)
NEXT_PUBLIC_APP_URL=http://localhost:3000
